# Server
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
CONFIG_PATH=./server-config.yaml

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/svarla
POSTGRES_PASSWORD=your_secure_db_password_here

# Server base URL (used for constructing provider webhook callback URLs)
BASE_URL=https://your-server.example.com

# CORS origin allowlist (comma-separated, required for production with web interface)
# Example: https://your-server.example.com
CORS_ORIGIN=

# Notifications (UnifiedPush — no server-side push provider config needed)
# The app registers its own push endpoint URL with the server after login.

# Initial password (REQUIRED on first run with empty database)
# The server will fail to start if no password exists and this is not set.
INITIAL_PASSWORD=your_secure_password_here

# [DEV ONLY] Override the version reported by /api/version.
# Useful for testing the Android app's update banner without changing package.json.
# DEV_VERSION_OVERRIDE=2.0.0

# Config encryption key (optional, encrypts sensitive provider fields at rest)
# When set, API secrets and private keys are encrypted in the database using AES-256-GCM.
# Use a strong random passphrase. If you lose this key, encrypted provider configs are unrecoverable.
# When unset, secrets are stored in plaintext (existing behavior).
CONFIG_ENCRYPTION_KEY=

# MediaBridge sidecar (Pion/Go audio relay)
# These override values from server-config.yaml when set.

# Public IP address advertised to WebRTC clients in ICE candidates.
# Required in production — set to the server's public-facing IP.
# PUBLIC_IP=203.0.113.10

# MediaBridge URL (localhost-only, default http://localhost:9090)
# Event WebSocket is derived automatically as {url}/events
# MEDIA_BRIDGE_URL=http://localhost:9090

# Health check polling interval in milliseconds
# MEDIA_BRIDGE_HEALTH_CHECK_INTERVAL=5000

# Domain for Caddy TLS (used in docker-compose.caddy.yml)
# DOMAIN=your-server.example.com

# Custom TLS certificate (optional, used instead of Let's Encrypt)
# TLS_CERT=/certs/cert.pem
# TLS_KEY=/certs/key.pem
# CERTS_DIR=./certs
