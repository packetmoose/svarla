FROM eclipse-temurin:17-jdk

ARG BUILD_TYPE=debug
ARG VERSION_NAME=
ARG VERSION_CODE=

ENV ANDROID_HOME=/opt/android-sdk
ENV PATH="${PATH}:${ANDROID_HOME}/cmdline-tools/latest/bin:${ANDROID_HOME}/platform-tools:${ANDROID_HOME}/build-tools/35.0.0"

# Install Android SDK command-line tools
RUN apt-get update && apt-get install -y --no-install-recommends unzip wget && \
    mkdir -p ${ANDROID_HOME}/cmdline-tools && \
    wget -q https://dl.google.com/android/repository/commandlinetools-linux-11076708_latest.zip -O /tmp/tools.zip && \
    unzip -q /tmp/tools.zip -d ${ANDROID_HOME}/cmdline-tools && \
    mv ${ANDROID_HOME}/cmdline-tools/cmdline-tools ${ANDROID_HOME}/cmdline-tools/latest && \
    rm /tmp/tools.zip && \
    yes | sdkmanager --licenses > /dev/null 2>&1 && \
    sdkmanager "platforms;android-35" "build-tools;35.0.0" "platform-tools" && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

WORKDIR /project
COPY . .

RUN chmod +x gradlew

# Inject version into build.gradle.kts if provided
RUN if [ -n "$VERSION_NAME" ]; then \
        sed -i "s/versionName = \".*\"/versionName = \"${VERSION_NAME}\"/" app/build.gradle.kts; \
    fi && \
    if [ -n "$VERSION_CODE" ]; then \
        sed -i "s/versionCode = [0-9]*/versionCode = ${VERSION_CODE}/" app/build.gradle.kts; \
    fi

# Build based on BUILD_TYPE argument
RUN if [ "$BUILD_TYPE" = "release" ]; then \
        ./gradlew assembleRelease --no-daemon; \
    else \
        ./gradlew assembleDebug --no-daemon; \
    fi

# Signing is done at runtime via the entrypoint script
COPY scripts/docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh

ENTRYPOINT ["/docker-entrypoint.sh"]
